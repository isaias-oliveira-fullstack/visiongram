    "axios": "^1.18.1",
    "jwt-decode": "^4.0.0",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "swiper": "^12.2.0",
    "vue": "^3.5.38",
    "vue-router": "^4.6.4",
    "vue-toastification": "^2.0.0-rc.5",
    "vue3-emoji-picker": "^1.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@rushstack/eslint-patch": "^1.16.1",
